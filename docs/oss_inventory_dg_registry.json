 "gap_proposals": [
  {
   "slug": "GAP-DG-ADER-TIME",
   "title": "ADER-DG 时空预测校正时间积分（对照 RK 基线）",
   "rationale": "TensorDG 时间推进仅 RK（README「Current scope」与 tensordg/ 实现），而 ADER-DG 是 DG 社区主流的高阶单步替代路径；SeisSol/Gkeyll 提供方法谱系证据。",
   "acceptance": "1-D Euler Sod 与 2-D isentropic vortex 在 p=1,2,3 下：观测收敛阶 >= p+1-0.15；vortex L2 密度误差 <1%；同一 CFL 下与 RK 基准解差 <1e-8；守恒量漂移 <1e-12；新增单测数 >=3",
   "domain": "TensorDG/time-integration",
   "priority": "P1",
   "repos_evidence": [
    "SeisSol/SeisSol",
    "gkeyllorg/gkeyll"
   ]
  },
  {
   "slug": "GAP-DG-3D-EULER",
   "title": "三维可压 Euler DG（现仅三维周期 advection）",
   "rationale": "tensordg/advection_3d.py 存在但无三维 Euler；Euler 仅 1-D/2-D。HORSES3D/UCNS3D/Trixi 提供三维 DG 工程参照。",
   "acceptance": "3-D isentropic vortex 在 p=1,2,3 上 h-收敛阶 >= p+0.85；L2 密度误差 <1%；8^3 单元 p=2 单节点运行 <600 s；无负密度/负压；守恒漂移 <1e-12",
   "domain": "TensorDG/compressible",
   "priority": "P1",
   "repos_evidence": [
    "horses-framework/horses3d",
    "ucns3d-team/UCNS3D",
    "trixi-framework/Trixi.jl"
   ]
  },
  {
   "slug": "GAP-DG-AMR",
   "title": "h-自适应（树结构 AMR + 2:1 平衡）",
   "rationale": "TensorDG 全部算例使用均匀张量积网格，无 AMR；t8code/AMReX/Trixi 提供树结构与负载平衡参照。",
   "acceptance": "2-D vortex advection 上：2:1 平衡成立（机器检查）、悬挂节点面通量守恒（漂移 <1e-11）；等自由度下误差 <= 0.7x 均匀网格误差；提供回归测试",
