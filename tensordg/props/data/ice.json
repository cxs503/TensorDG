          "source": {
            "ref": "Timco & Weeks (2010) A review of the engineering properties of sea ice, Cold Reg. Sci. Tech. 60:107-129, Sec. 3",
            "type": "constant",
            "note": "nominal 900 kg/m^3; measured range 720-940 kg/m^3 (desalinated / bubbly ice at the lower end)"
          },
          "accuracy": "nominal value; +/- 10% within the literature range",
          "applicability": "-30 to 0 degC, first-year sea ice"
