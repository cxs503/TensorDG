          "domain": {"T": [-30.0, 0.0], "P": [1000.0, 10000000.0]},
          "source": {
            "ref": "Timco & Weeks (2010), Sec. 4 (elastic modulus of sea ice)",
            "type": "constant",
            "note": "E depends on strain rate and porosity; reported range 1-10 GPa, 8 GPa recommended for elastic ice-load models"
          },
          "accuracy": "order-of-magnitude property; use only inside its 1-10 GPa range",
